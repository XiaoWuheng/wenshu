# Copy to .env for local setup. This file is ignored by Git.
WENSHU_HOST=127.0.0.1
WENSHU_PORT=4173

# Optional AI provider. Keep the secret key on the server only.
WENSHU_AI_BASE_URL=https://api.openai.com/v1
WENSHU_AI_API_KEY=
WENSHU_AI_MODEL=
# responses or chat-completions (for compatible providers)
WENSHU_AI_API_STYLE=responses

# Required when binding to a network interface other than localhost.
# Use a long random value and put the service behind HTTPS.
WENSHU_ACCESS_TOKEN=
